# The published site is plain static files at the repo root plus assets/.
# Everything below is local working context that should not ship with it.

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code — local working context.
# launch.json stays tracked: it is the dev-server config, useful on a clone.
.claude/skills/
.claude/settings.local.json
.claude/scratch/

# Private research — business analysis, revenue figures, unreleased pricing.
# Deliberately not published: this repo is public.
analysis/

# Working reference/research notes per project (App Store & Google Play
# listings, review excerpts, competitor context, etc.) — raw material for
# writing case studies, not meant to ship verbatim. Pull specific facts
# into content/portfolio/<slug>.md by hand; this folder stays local.
references/

# Raw Figma bulk exports (every screen, case/section/name.png) — local
# staging only. Pick specific screens from here, convert to webp, and
# drop the curated set into assets/projects/<slug>/ by hand; this whole
# raw dump never gets committed.
figma-exports/

# Python — analysis tooling and virtualenvs
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Node — if any tooling ever lands here
node_modules/
npm-debug.log*
yarn-error.log*

# Build output — the deploy workflow assembles this in CI
_site/

# Logs and scratch
*.log
scratch/
tmp/
